    given-names: Guo
    affiliation: "Hangzhou Institute of Medicine, Chinese Academy of Sciences, Hangzhou, China; University of Chinese Academy of Sciences, Beijing, China"
    orcid: "https://orcid.org/0009-0006-7813-0114"
repository-code: "https://github.com/GuoCheng24/worldmodel-from-scratch"
license: MIT
keywords:
  - world models
  - model-based reinforcement learning
  - rollout error
  - representation collapse
  - reproducibility
